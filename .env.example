# ---------------------------------------------------------------------------
# 4ur — variables d'environnement (copier vers .env.local, ne jamais committer)
# Voir README.md → « Déploiement Render » pour les valeurs en production.
# ---------------------------------------------------------------------------

# Base de données SQLite (Prisma)
# En local : chemin relatif au dossier prisma/.
# Sur Render sans disque persistant : chemin absolu vers /tmp, la base est
# recréée au démarrage (voir README).
DATABASE_URL="file:./db/custom.db"

# --- Panneau dev caché (obligatoire pour l'utiliser) ------------------------
# Code d'accès au panneau (footer : 5 clics rapides sur le ©, ou taper "4ur")
DEV_PANEL_PIN="changez-moi"
# Secret de signature des cookies de session : openssl rand -hex 32
DEV_PANEL_SECRET="changez-moi-avec-une-chaine-longue-et-aleatoire"

# --- Sécurité réseau --------------------------------------------------------
# Mettre "1" UNIQUEMENT si un reverse-proxy de confiance (Render, Caddy, Nginx…)
# est devant l'application : l'IP client est alors lue dans X-Forwarded-For.
# Sans cela, l'IP est considérée comme inconnue (quota partagé, plus strict).
TRUST_PROXY="1"

# --- Site -------------------------------------------------------------------
# ⚠️ lu au BUILD : toute modification impose un redéploiement.
NEXT_PUBLIC_SITE_URL="https://4ur.onrender.com"

# --- Notification des demandes de contact -----------------------------------
# OBLIGATOIRE si la base n'est pas persistante (sinon les demandes sont perdues
# au redémarrage).
# Option A : e-mail via Resend (https://resend.com) — domaine à vérifier
RESEND_API_KEY=""
CONTACT_NOTIFY_EMAIL="contact@4ur.fr"
CONTACT_FROM_EMAIL="4ur <contact@4ur.fr>"
# Option B : webhook générique (Slack, Discord, Make, n8n…) — POST JSON
CONTACT_WEBHOOK_URL=""

# --- Mentions légales / confidentialité -------------------------------------
# ⚠️ lues au BUILD : toute modification impose un redéploiement.
NEXT_PUBLIC_COMPANY_NAME="4ur"
NEXT_PUBLIC_LEGAL_FORM="SASU"
NEXT_PUBLIC_CAPITAL=""
NEXT_PUBLIC_SIREN=""
NEXT_PUBLIC_SIRET=""
NEXT_PUBLIC_RCS=""
NEXT_PUBLIC_VAT=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_CONTACT_EMAIL="contact@4ur.fr"
NEXT_PUBLIC_PHONE=""
NEXT_PUBLIC_DIRECTOR=""
NEXT_PUBLIC_DPO=""
NEXT_PUBLIC_HOST_NAME=""
NEXT_PUBLIC_HOST_ADDRESS=""
NEXT_PUBLIC_HOST_PHONE=""
